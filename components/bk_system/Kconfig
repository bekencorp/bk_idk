#TODO may need to remove this component!
menu "BK_system"

	menu "Mac Config"
		choice BASE_MAC_SRC
			prompt "Select Base Mac Source"
			default NEW_MAC_POLICY

			config BASE_MAC_FROM_EFUSE
				bool "BASE_MAC_FROM_EFUSE"
			config BASE_MAC_FROM_RF_OTP_FLASH
				bool "BASE_MAC_FROM_RF_OTP_FLASH"
			config NEW_MAC_POLICY
				bool "NEW_MAC_POLICY"
			config BASE_MAC_FROM_OTP1
				bool "BASE_MAC_FROM_OTP1"
		endchoice

		config RANDOM_MAC_ADDR
	        bool "Enable Random Mac Addr"
	        default n

		config BK_MAC_ADDR_CHECK
			bool "Enable Beken Mac Addr Check"
			default n

		config CUS_MAC_MASK
			hex "Set Customize Mac Address Mask"
			default 0
	endmenu

    menu "Product ID Config"
        choice SPID_OFFSET_IN_BOOT_CHOICE
            prompt "SPID offset in boot"
            default SPID_OFFSET_IN_BOOT_0X8

            config SPID_OFFSET_IN_BOOT_0X8
                bool "0x8"

            config SPID_OFFSET_IN_BOOT_0XA
                bool "0xA"
        endchoice

        config SPID_OFFSET_IN_BOOT
            hex
            default 0x8 if SPID_OFFSET_IN_BOOT_0X8
            default 0xA if SPID_OFFSET_IN_BOOT_0XA
            help
                Offset of product ID field relative to boot base address.
                Final write address is:
                - CRC mode:    0x110 + CONFIG_SPID_OFFSET_IN_BOOT
                - NO_CRC mode: 0x100 + CONFIG_SPID_OFFSET_IN_BOOT
                Only 0x8 and 0xA are supported.
    endmenu

	menu "Print Config"
		choice SYSTEM_PRINT_DEVICE
			prompt "System print device"
			default SYS_PRINT_DEV_UART

			config SYS_PRINT_DEV_UART
				bool "System print by uart"

			config SYS_PRINT_DEV_MAILBOX
				bool "System print by mailbox"

			config SYS_PRINT_DEV_NULL
				bool "Close system print"
		endchoice

		choice SYSTEM_LOG_LEVEL
			prompt "System log level"
			default SYS_LOG_INFO
			config SYS_LOG_NONE
				bool "No output"
			config SYS_LOG_ERROR
				bool "Error"
			config SYS_LOG_WARN
				bool "Warning"
			config SYS_LOG_INFO
				bool "Info"
			config SYS_LOG_DEBUG
				bool "Debug"
			config SYS_LOG_VERBOSE
				bool "Verbose"
		endchoice

		config SUPPORT_LOG_LEVEL_CFG
			bool "support config log level"
			default n

		config FWD_CMD_TO_CPUx
			depends on MAILBOX
			bool "Forward cpu1/cpu2 cmd by mailbox"
			default y

		config SMP_SYNC_PRINTF
			bool "smp sync printf"
			default n

		config UART_PRINT_BAUD_RATE
			depends on SYS_PRINT_DEV_UART
			int "uart print baud rate"
			default "115200"
	endmenu
endmenu
