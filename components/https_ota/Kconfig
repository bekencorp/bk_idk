menu "Https_ota"
	config OTA_TEST
		bool "Enable ota test"
		default n

	config OTA_UPDATE_PUBKEY
		bool "use public key in flash"
		default n

	config OTA_BACKUP_PUBKEY
		bool "backup public key in flash partition"
		default n

	config VALIDATE_DURING_DOWNLOADING
		bool "mcuboot validate before reboot"
		default n
	
	config VALIDATE_IMAGE
		bool "global signature verification switch"
		default y
	
	config VALIDATE_IMAGE_HASH_ONLY
		bool "Validate image hash only (skip pubkey and signature TLV)"
		default n
		help
			When enabled, BL2 and application OTA stop after SHA TLV matches
			the computed digest; pubkey and signature TLVs are not verified.
endmenu
