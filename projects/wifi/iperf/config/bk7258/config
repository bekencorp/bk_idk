CONFIG_UART_PM_CB_SUPPORT=n
# end of UART

#
# SDIO_HOST
#
#@ Enable sdio host
CONFIG_SDIO_HOST=y
#@ SDIO Host default clock freq
CONFIG_SDIO_HOST_DEFAULT_CLOCK_FREQ=7
# end of SDIO_HOST

#
# SDCARD
#
#@ Enable SDcard power gpio ctrl
CONFIG_SDCARD_POWER_GPIO_CTRL=n
#@ Enable SDcard auto powerdown when idle
CONFIG_SDCARD_POWER_GPIO_CTRL_AUTO_POWERDOWN_WHEN_IDLE=n
# end of SDCARD

#
# FATFS
#
#@ Support FATFS
CONFIG_FATFS=n
#@ Support SDCARD FATFS
CONFIG_FATFS_SDCARD=n
# end of FATFS

#
# SDIO
#
#@ Enable SDIO
CONFIG_SDIO=n
#@ SDIO transfer data whether enable GDMA
CONFIG_SDIO_GDMA_EN=n
# end of SDIO

#
# SPI
#
#@ Enable SPI DMA
CONFIG_SPI_DMA=n
#@ SPI ENABLE
CONFIG_SPI=n
#@ SPI byte interval
CONFIG_SPI_BYTE_INTERVAL=y
# end of SPI

#
# AON_RTC
#
#@ Enable rtc keep time when enter deepsleep,set data on flash
CONFIG_AON_RTC_KEEP_TIME_SUPPORT=n
# end of AON_RTC

#
# GPIO
#
#@ If not open, gpio could not keep state when the always on power domain is off
CONFIG_GPIO_RETENTION_SUPPORT=y
# end of GPIO

#
# GENERAL_DMA
#
#@ 4
CONFIG_DMA_LOGIC_CHAN_CNT=16
#@ 0
CONFIG_DMA_LOGIC_CHAN_ID_MIN=0
# end of GENERAL_DMA

#
# PSRAM
#
#@ Enable PSRAM
CONFIG_PSRAM=n
#@ Enable psram_malloc API
CONFIG_PSRAM_AS_SYS_MEMORY=n
# CONFIG_USE_PSRAM_HEAP_AT_SRAM_OOM is not set
#@ Enable PSRAM write through
CONFIG_PSRAM_WRITE_THROUGH=n
#@ Enable PSRAM calibrate
CONFIG_PSRAM_CALIBRATE=n
#@ Enable PSRAM id auto detect function
CONFIG_PSRAM_AUTO_DETECT=n
# end of PSRAM

#
# I2C
#
#@ Enable I2C
CONFIG_I2C=n
# end of I2C

#
# AUDIO
#
#@ Enable audio adc driver
CONFIG_AUDIO_ADC=n
# CONFIG_AUDIO_DMIC is not set
# CONFIG_AUDIO_DTMF is not set
#@ Enable audio dac driver
CONFIG_AUDIO_DAC=n
# end of AUDIO

#
# PWM
#
#@ Enable pwm
CONFIG_PWM=y
#@ PWM PM Support
CONFIG_PWM_PM_CB_SUPPORT=n
# end of PWM

#
# TIMER
#
#@ 0 indicates that all IDs are supported by default, no configuration required
CONFIG_TIMER_SUPPORT_ID_BITS=63
#@ Enable TIMER enter low voltage callback support
CONFIG_TIMER_PM_CB_SUPPORT=n
# end of TIMER

#
# FLASH
#
#@ Enable flash mailbox channel
CONFIG_FLASH_MB=n
# end of FLASH

#
# PWR_CLK
#
#@ ahbp power domain disable
CONFIG_AHBP_POWER_DOMAIN_LV_DISABLE=y
#@ psram power domain disable
CONFIG_PSRAM_POWER_DOMAIN_LV_DISABLE=y
