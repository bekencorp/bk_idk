#@ Enable Wifi Cli Enable
CONFIG_WIFI_CLI_ENABLE=y
#@ Enable Bluetooth
CONFIG_BLUETOOTH=n
#@ Enable Iperf Test
CONFIG_IPERF_TEST=y
#@ Enable Cli
CONFIG_CLI=y

#@ When this option is enable, more memory will be consumed because
CONFIG_MEM_DEBUG=n
#@ FreeRTOS Trace
CONFIG_FREERTOS_TRACE=n
#@ Enable Cache
CONFIG_CACHE_ENABLE=n

#@ Set maximum segment size for TCP transmission.
CONFIG_LWIP_TCP_MSS=1460
////default config
//CONFIG_LWIP_TCP_SND_BUF=29200
//CONFIG_LWIP_TCP_WND=29200


////default config
//CONFIG_LWIP_UDP_RECVMBOX_SIZE=24
//CONFIG_LWIP_TCP_SND_QUEUELEN=40

////default config
//CONFIG_LWIP_MEM_SIZE=51200
//CONFIG_LWIP_MEM_MAX_RX_SIZE=38400
//CONFIG_LWIP_MEM_MAX_TX_SIZE=42666
#@ Set UDP receive mail box size. The recommended value is 24.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
#@ Set the size of the heap memory. The recommended value is 51200 .
CONFIG_LWIP_MEM_SIZE=92160
#@ Set the size of the max memory rx used. The recommended value is
CONFIG_LWIP_MEM_MAX_RX_SIZE=76800
#@ Set the size of the max memory tx used. The recommended value is
CONFIG_LWIP_MEM_MAX_TX_SIZE=81920
#@ Set the number of struct netbufs.
CONFIG_LWIP_MEMP_NUM_NETBUF=128
#@ Set the size of each pbuf in the pbuf pool. The default is
CONFIG_LWIP_PBUF_POOL_SIZE=10
#@ Set TCP sender buffer space (pbufs).
CONFIG_LWIP_TCP_SND_QUEUELEN=60
#@ Set the number of simultaneously queued TCP segments.
CONFIG_LWIP_MEMP_NUM_TCP_SEG=80
#@ Set default send buffer size for new TCP sockets.
CONFIG_LWIP_TCP_SND_BUF=43800
#@ Set default TCP receive window size for new TCP sockets.
CONFIG_LWIP_TCP_WND=43800

#
# Bk_cli
#
#@ Enable Audio
CONFIG_AUDIO=n
#@ Enable Psram Test
CONFIG_PSRAM_TEST=n
# end of Bk_cli

#
# Https
#
#@ Enable HTTPS
CONFIG_HTTPS=y
# end of Https

#
# Mac Config
#
#@ BASE_MAC_FROM_RF_OTP_FLASH
CONFIG_BASE_MAC_FROM_RF_OTP_FLASH=y
#@ NEW_MAC_POLICY
CONFIG_NEW_MAC_POLICY=n
#@ Enable Beken Mac Addr Check
CONFIG_BK_MAC_ADDR_CHECK=n
# end of Mac Config

#
# bk_uid
#
#@ Enable get UID
CONFIG_GET_UID_ENABLE=n
#@ Enable get UID test
CONFIG_GET_UID_TEST=n
# end of bk_uid

#
# Bk_usb
#
#@ Enable USB
CONFIG_USB=n
# end of Bk_usb

#
# Modify USB Mailbox
#
#@ Enable Multi-core operation USB
CONFIG_USB_MAILBOX=n
#@ Enable USB mailbox slave
CONFIG_USB_MAILBOX_SLAVE=n
# end of Modify USB Mailbox

# Modify Usb Config
#
# CONFIG_MUSB_FDRC is not set
#@ MUSBMHDRC
CONFIG_MUSB_MHDRC=n
# CONFIG_SYNOPSYS_DWC2_USB_IP is not set
# CONFIG_MENTOR_USB is not set
#@ CHERRY_USB
CONFIG_CHERRY_USB=n
#@ Enable USB Host Mode
CONFIG_USB_HOST=n
# CONFIG_USB_DEVICE is not set
# CONFIG_USB1_PORT is not set
#@ USB2_PORT
CONFIG_USB2_PORT=n
#CONFIG_TASK_USB_PRIO=2
# CONFIG_USB_DMA_ENABLE is not set
#@ Enable USB hub
CONFIG_USB_HUB=n
#@ Enable Usb Msd
CONFIG_USB_MSD=n
# CONFIG_USB_UPC is not set
# CONFIG_USB_HID is not set
# CONFIG_USB_CCD is not set
#@ Enable Usb Uvc
CONFIG_USB_UVC=n
#@ Enable Usb Uac
CONFIG_USB_UAC=n

#
# Modify Usb Uac Config
#
#@ Enable Usb Uac Mic
CONFIG_USB_UAC_MIC=n
#@ Enable Usb Uac Speaker
CONFIG_USB_UAC_SPEAKER=n
# end of Modify Usb Uac Config

# CONFIG_USB_CHARGE is not set
# end of Modify Usb Config

#
# Modify USB Demo Config
#
# CONFIG_UVC_OTA_DEMO is not set
# end of Modify USB Demo Config

#
# Modify USB Demo Config
#
CONFIG_UVC_UAC_DEMO=n
CONFIG_UVC_UAC_DEMO_DEBUG=n
# end of Modify USB Demo Config

#
# decompress
#
#@ Enable LZMA1900
CONFIG_LZMA1900=y
# end of decompress

#
# Modify Lwip Config
#
#@ use system libc malloc
CONFIG_LWIP_MEM_LIBC_MALLOC=n
#@ memp_alloc() use mem_malloc/mem_free instead of the lwip pool allocator
CONFIG_LWIP_MEMP_MEM_MALLOC=n
# end of Modify Lwip Config

#
# Ota
#
#@ enable https ota
CONFIG_OTA_HTTPS=y
# end of Ota

#
# Tfm
#
# CONFIG_TFM is not set
# end of Tfm

# CONFIG_SECURITY_FIRMWARE is not set

#
# UART
#
#@ Enable UART2
CONFIG_UART2=n
#@ Enable UART3
CONFIG_UART3=n
