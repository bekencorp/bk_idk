CONFIG_LPO_MP_A_FORCE_USE_EXT32K=n
#@ enable rosc compensation for rtc tick
CONFIG_ROSC_COMPENSATION=y
#@ enable dig ldo low voltage
CONFIG_DIGLDO_LOW_VOLTAGE_ENABLE=y
# end of PWR_CLK

#
# HW_ROTATE
#
#@ Enable hw rotate and pixel convert module
CONFIG_HW_ROTATE_PFC=y
# end of HW_ROTATE

#
# CAMERA
#
CONFIG_UVC_CHECK_BULK_JPEG_HEADER=n
# end of CAMERA

#
# SCR
#
#@ Enable smart_card_reader
CONFIG_SCR=n
# end of SCR

#
# bk7258
