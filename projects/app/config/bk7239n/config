# GPIO/PM callback configuration for bk7239n platform features
#@ Enable GPIO default set devs
CONFIG_GPIO_DEFAULT_SET_SUPPORT=n
#@ Enable UART enter low voltage callback support
CONFIG_UART_PM_CB_SUPPORT=y
#@ Enable TIMER enter low voltage callback support
CONFIG_TIMER_PM_CB_SUPPORT=y

#@ Prioritize SPI ISR so DMA/PM interactions stay responsive.
CONFIG_SUPPORT_SPI_ISR_HIGH_PRIORITY=y

#@ Signal upper layers when UART is ready to transmit after low-voltage entry.
CONFIG_SUPPORT_XMIT_READY_CALLBACK=y

#@ Keep flash status volatile to prevent stale writes after suspend.
CONFIG_FLASH_WRITE_STATUS_VOLATILE=y

#@ Normalize all console data to UTF-8.
CONFIG_USE_CONV_UTF8=y

#@ Disable buck regulator support in this app build.
CONFIG_BUCK_ENABLE=n
